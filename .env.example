# ---- LLM: pick ONE provider block. Switching = edit these two lines. ----
LLM_PROVIDER=anthropic
LLM_MODEL=<anthropic-model-id>
ANTHROPIC_API_KEY=sk-ant-...

# openai
# LLM_PROVIDER=openai
# LLM_MODEL=<openai-model-id>
# OPENAI_API_KEY=sk-...

# google
# LLM_PROVIDER=google
# LLM_MODEL=<google-model-id>
# GOOGLE_GENERATIVE_AI_API_KEY=...

# ---- server ----
PORT=3000
# comma-separated origins allowed to call /api/*. "*" allows any (dev only).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
